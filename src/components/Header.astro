---
import Icon from './Icon.astro';
import { profile } from '../content/profile';
interface Props { active: string; }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [{key:'home',label:'Home',icon:'✦',path:''},{key:'about',label:'About',icon:'♟',path:'about/'},{key:'work',label:'Selected work',icon:'▦',path:'work/'}];
---
<header class="site-header">
  <a class="brand-mark" href={`${base}/`} aria-label="mrayandika home"><span aria-hidden="true">☺</span></a>
  <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
  <nav id="main-nav" aria-label="Main navigation">{links.map(link=><a href={`${base}/${link.path}`} class:list={['nav-link',{'active':active===link.key}]} aria-current={active===link.key?'page':undefined}><span aria-hidden="true">{link.icon}</span>{link.label}</a>)}</nav>
  <div class="nav-socials"><a class="social-dot yellow" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)"><Icon name="github" size={15}/></a><a class="social-dot pink" href={profile.upwork} target="_blank" rel="noopener noreferrer" aria-label="Upwork profile (opens in a new tab)"><span class="dot-text" aria-hidden="true">up</span></a><a class="social-dot green" href={`${base}/about/`} aria-label="About mrayandika"><span aria-hidden="true">m</span></a></div>
  <a class:list={['nav-contact',{'active':active==='contact'}]} aria-current={active==='contact'?'page':undefined} href={`${base}/contact/`}><span aria-hidden="true">♥</span> Contact</a>
</header>
