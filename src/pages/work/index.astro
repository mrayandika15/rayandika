---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ContactCta from '../../components/ContactCta.astro';
import {projects} from '../../content/projects';
import {profile} from '../../content/profile';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Selected work" active="work">
  <header class="page-heading enter"><span class="hand">open my files</span><h1 class="display">Featured works</h1><p>A few ideas, turned into things you can explore.</p></header>
  <section class="work-grid section-pad" aria-label="Selected projects">{projects.map((project,i)=><article class="work-card reveal"><a class="work-card-link" href={`${base}/work/${project.slug}/`}><div class:list={['work-file',`work-file-${i}`]}><span class="mono work-file-label">✦ Project {project.number} / {project.category}</span><ProjectVisual kind={project.visual} shot={project.shot} shot2={project.shot2} eager={i === 0}/>{project.logo && <img class="client-sticker" src={`${base}/${project.logo.src}`} alt={project.logo.alt} width={project.logo.width} height={project.logo.height} loading="lazy" />}{project.logo2 && <img class="client-sticker client-sticker-2" src={`${base}/${project.logo2.src}`} alt={project.logo2.alt} width={project.logo2.width} height={project.logo2.height} loading="lazy" />}<span class="mono work-file-caption">{project.shot2 ? 'Real screenshots' : project.shot ? 'Real screenshot' : 'Concept illustration'}</span></div>{project.hook ? <h2 class="hook-title"><span class="hook-line hook-problem">{project.hook.problem}</span><span class="hook-line hook-solution"><span aria-hidden="true">→</span> {project.hook.solution} <span aria-hidden="true">↗</span></span></h2> : <h2>{project.name} <span aria-hidden="true">↗</span></h2>}<p>{project.description}</p></a><div class="work-card-tags mono">{project.tags.join(' / ')}</div></article>)}</section>
  <div class="more-work section-pad"><span class="hand">there's always something in progress</span><a class="ink-link" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener noreferrer">More on GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a></div>
  <ContactCta />
</BaseLayout>
