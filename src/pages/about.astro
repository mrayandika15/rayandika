---
import BaseLayout from '../layouts/BaseLayout.astro';
import Polaroid from '../components/Polaroid.astro';
import ContactCta from '../components/ContactCta.astro';
import {experience} from '../content/experience';
import {profile} from '../content/profile';
---
<BaseLayout title="The person behind the keyboard" active="about">
  <header class="page-heading enter"><span class="hand">a little more about me</span><h1 class="display">About</h1></header>
  <div class="about-page section-pad"><nav class="note-nav" aria-label="About sections"><a class="torn yellow" href="#main-bio">↳ Main bio</a><a class="torn mint" href="#experience">↳ Experience</a><a class="torn pink" href="#my-approach">↳ My approach</a><a class="torn blue" href="#my-tools">↳ My tools</a></nav><div class="bio-pages"><section class="bio-sheet reveal" id="main-bio"><span class="torn butter note-heading mono">Main bio</span><Polaroid src={profile.portrait} alt="Muhammad Rayandika smiling" caption="hello from Bandung ☀" class="bio-photo" eager /><p class="hand bio-lead">I build AI agent teams that turn complex business processes into useful, connected workflows.</p><p>I'm <strong>{profile.name}</strong>, an <strong>{profile.role}</strong> based in {profile.location}. I bring <strong>4+ years of software engineering experience</strong> to the systems I build.</p><p>I specialize in AI Agentic Workflows, Multi-Agent Systems, and AI Harness Engineering. I design intelligent agents that collaborate, automate complex workflows, and integrate with existing business tools.</p><p>My foundation is full-stack software engineering: Python and Java services, reusable frontend libraries, web and mobile applications, and interactive GIS interfaces. Combining that experience with AI orchestration helps me deliver scalable, reliable solutions that reduce manual work and support business growth.</p><span class="hand signature">Rayandika <span aria-hidden="true">✳</span></span></section><section class="bio-sheet reveal" id="experience"><span class="torn mint note-heading mono">Professional experience</span><h2>Agentic systems.<br />Engineering foundations.</h2><div class="experience-list">{experience.map((item)=><article class="experience-entry"><p class="mono experience-context">{item.context}</p><h3>{item.title}</h3><ul>{item.bullets.map((bullet)=><li>{bullet}</li>)}</ul></article>)}</div></section><section class="bio-sheet reveal" id="my-approach"><span class="torn blush note-heading mono">My approach</span><h2>Less magic.<br />More making it work.</h2><ol class="approach-list"><li><span>01</span><div><h3>Understand the actual problem.</h3><p>Map the business process, its bottlenecks, and the outcome you need. Decide which steps benefit from automation.</p></div></li><li><span>02</span><div><h3>Make the pieces make sense.</h3><p>Define agent responsibilities, shared context, tool integrations, and the checkpoints that need a human decision.</p></div></li><li><span>03</span><div><h3>Build, try, and make it better.</h3><p>Implement the workflow and supporting software, validate how the pieces work together, and refine reliability and usability.</p></div></li></ol></section><section class="bio-sheet reveal" id="my-tools"><span class="torn lavender note-heading mono">My tools</span><h2>Whatever helps<br />the idea happen.</h2><p>The software engineering toolkit behind my agent integrations, full-stack applications, and GIS interfaces.</p><div class="bio-tools">{profile.tools.map((tool,i)=><span class:list={['torn',['yellow','mint','lavender','blush'][i%4]]}>{tool}</span>)}</div><p class="hand">Always learning. Always another tab open.</p></section></div></div>
  <ContactCta />
</BaseLayout>
