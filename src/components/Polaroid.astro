---
interface Props { src: string; alt: string; caption: string; class?: string; eager?: boolean; }
const { src, alt, caption, class: className = '', eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<figure class:list={['polaroid',className]}><span class="tape tape-left" aria-hidden="true"></span><span class="tape tape-right" aria-hidden="true"></span><img src={`${base}/${src}`} alt={alt} width="500" height="640" loading={eager?'eager':'lazy'} /><figcaption>{caption}</figcaption></figure>
