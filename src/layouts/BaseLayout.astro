---
import '@fontsource-variable/manrope';
import '@fontsource/jersey-10/latin-400.css';
import '@fontsource/kalam/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { profile } from '../content/profile';
interface Props { title?: string; description?: string; active?: string; }
const { title = 'A little code. A lot of curiosity.', description = profile.description, active = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f8f3" />
    <title>{profile.shortName} · {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.shortName} · ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/${profile.portrait}`, Astro.site)} />
    <meta property="og:image:width" content="720" />
    <meta property="og:image:height" content="960" />
    <meta property="og:image:alt" content="Muhammad Rayandika smiling, wearing glasses and a denim jacket." />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="notebook" id="top">
      <Header active={active} />
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <a class="footer-name" href={`${base}/`}>mrayandika<span aria-hidden="true">✳</span></a>
        <span>A work in progress, just like me. © {new Date().getFullYear()}</span>
        <a href="#top">Back to top ↑</a>
      </footer>
    </div>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
