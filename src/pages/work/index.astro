---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ContactCta from '../../components/ContactCta.astro';
import {projects} from '../../content/projects';
import {profile} from '../../content/profile';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<BaseLayout title="Selected work" active="work">
  <header class="page-heading enter"><span class="hand">open my files</span><h1 class="display">Featured works</h1><p>A few ideas, turned into things you can explore.</p></header>
  <section class="work-grid section-pad" aria-label="Selected projects">{projects.map((project,i)=><article class="work-card reveal"><a class="work-card-link" href={`${base}/work/${project.slug}/`}><div class:list={['work-file',`work-file-${i}`]}><span class="mono work-file-label">✦ Project {project.number} / {project.category}</span><ProjectVisual kind={project.visual} shot={project.shot} eager={i === 0}/><span class="mono work-file-caption">{project.shot ? 'Real screenshot' : 'Concept illustration'}</span></div><h2>{project.name} <span aria-hidden="true">↗</span></h2><p>{project.description}</p></a><div class="work-card-tags mono">{project.tags.join(' / ')}</div></article>)}</section>
  <div class="more-work section-pad"><span class="hand">there's always something in progress</span><a class="ink-link" href={`${profile.github}?tab=repositories`} target="_blank" rel="noopener noreferrer">More on GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a></div>
  <ContactCta />
</BaseLayout>
