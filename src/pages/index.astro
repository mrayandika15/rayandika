---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutScrapbook from '../components/AboutScrapbook.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import ContactCta from '../components/ContactCta.astro';
import { profile } from '../content/profile';
import { services } from '../content/experience';
import { projects } from '../content/projects';
const featured = projects.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="AI Agent Engineer · Multi-Agent Systems & Workflow Automation">
  <section class="scrapbook-hero" aria-labelledby="hero-title">
    <div class="hero-name-block enter"><span class="hand name-note">my name is<span aria-hidden="true">⌁</span></span><span class="pill-sticker mint">Make things</span><span class="pill-sticker butter">Sweat the details</span><h1 id="hero-title" class="display">mrayandika<span class="name-outline" aria-hidden="true"></span></h1><span class="role-sticker hand yellow">AI Agent Engineer <span aria-hidden="true">↗</span></span><span class="location-sticker hand mint">Bandung, ID <span aria-hidden="true">↖</span></span></div>
    <p class="hero-status mono enter"><span></span> Multi-Agent Systems & Workflow Automation</p>
    <div class="hero-statement enter"><span class="avatar-stamp" aria-hidden="true"><img src={`${base}/${profile.portrait}`} alt="" width="58" height="58" /></span><h2>I build AI teams that <span class="target-doodle" aria-hidden="true">◎</span><br />make work flow. <span class="flower-doodle" aria-hidden="true">✿</span></h2><span class="code-stamp" aria-hidden="true">&lt;/&gt;</span></div>
    <p class="hero-summary enter">4+ years in software engineering. Now building intelligent agents,<br class="desktop-break" /> connected tools, and workflows that lighten your workload.</p>
    <a class="button button-ink enter" href={`${base}/contact/`}><span class="button-icon blue" aria-hidden="true">↗</span> Let’s build your workflow</a>
    <a class="hero-scroll hand" href="#about-home">there's more down here <span aria-hidden="true">↓</span></a>
    <div class="pencil-curve" aria-hidden="true"></div>
  </section>
  <div id="about-home"><AboutScrapbook /></div>
  <section class="agent-services section-pad" aria-labelledby="services-title">
    <div class="section-caption"><span class="hand">how I can help</span><a class="ink-link" href={`${base}/about/#experience`}>My experience ↗</a></div>
    <h2 id="services-title">From a business process<br />to a working agent system.</h2>
    <div class="service-notes">{services.map((service,i)=><article class="service-note reveal"><span class:list={['torn', ['butter','mint','lavender'][i]]}>0{i+1}</span><h3>{service.title}</h3><p>{service.description}</p><p class="mono service-deliverable">{service.deliverable}</p></article>)}</div>
  </section>
  <section class="featured-work section-pad" aria-labelledby="featured-title"><div class="section-caption"><span class="hand">some things I've made</span><h2 id="featured-title" class="sr-only">Selected projects</h2><a class="ink-link" href={`${base}/work/`}>All selected work ↗</a></div><nav class="folder-navigation" aria-label="Jump to a project">{featured.map((project,i)=><a href={`#project-${project.number}`} class:list={['folder-tab',i===0?'blue':i===1?'ink':'yellow']}><span aria-hidden="true">✦</span> Project {project.number}</a>)}</nav><div class="folder-stack">{featured.map((project,i)=><article id={`project-${project.number}`} class:list={['project-folder',`folder-${i}`, 'reveal']}><div class="folder-body"><div class="folder-copy"><span class="mono project-category"><span aria-hidden="true">●</span> {project.category}</span>{project.hook ? <h3 class="hook-title"><span class="hook-line hook-problem"><span class="hook-label hand">the problem</span>{project.hook.problem}</span><span class="hook-line hook-solution"><span class="hook-label hand">the fix <span aria-hidden="true">→</span></span>{project.hook.solution}</span></h3> : <h3>{project.name}</h3>}<p>{project.description}</p><a class="ink-link" href={`${base}/work/${project.slug}/`}>Explore project <span aria-hidden="true">↗</span></a><span class="folder-number mono">FILE NO. {project.number} / {project.internal ? 'INTERNAL TOOL' : project.company ? 'COMPANY PRODUCT' : project.client ? 'CLIENT PROJECT' : 'PERSONAL PROJECT'}</span></div><a class="project-picture" href={`${base}/work/${project.slug}/`} aria-label={`Explore ${project.name}`}><span class="tape tape-left" aria-hidden="true"></span><span class="tape tape-right" aria-hidden="true"></span><ProjectVisual kind={project.visual} shot={project.shot} eager={i === 0} />{project.logo && <img class="client-sticker" src={`${base}/${project.logo.src}`} alt={project.logo.alt} width={project.logo.width} height={project.logo.height} loading="lazy" />}<span class="picture-caption mono">{project.shot ? 'Real screenshot' : 'Concept illustration'} · {project.tags[0]}</span></a></div></article>)}</div></section>
  <section class="toolbox section-pad reveal" aria-label="Tools I work with"><p class="hand">a few things in my toolbox</p><div>{profile.tools.map((tool,i)=><span class:list={['torn', ['butter','mint','lavender','blush'][i%4]]}>{tool}</span>)}</div></section>
  <ContactCta />
</BaseLayout>
