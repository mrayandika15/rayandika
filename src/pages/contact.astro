---
import BaseLayout from '../layouts/BaseLayout.astro';
import Polaroid from '../components/Polaroid.astro';
import {profile} from '../content/profile';
---
<BaseLayout title="Say hello" active="contact">
  <section class="contact-page section-pad"><div class="page-heading enter"><span class="hand">say hi</span><h1 class="display selection-title">Contact<span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></h1></div><div class="contact-collage"><Polaroid src="images/scrapbook/code.jpg" alt="A laptop displaying code, a programming inspiration photo" caption="one idea at a time" class="contact-photo-left" /><div class="contact-note enter"><span class="tape tape-top" aria-hidden="true"></span><p class="mono note-opener">Need an AI agent team, workflow automation, or a software engineering partner? Let’s talk about what you want to build.</p><p class="hand">Tell me about your current process, the tools you use, and what you’d like to automate.</p><div class="contact-note-actions"><a class="button button-ink" href={profile.email?`mailto:${profile.email}`:profile.github} target={profile.email?undefined:'_blank'} rel={profile.email?undefined:'noopener noreferrer'}>{profile.email?'Send a hello':'Find me on GitHub'} ↗{!profile.email&&<span class="sr-only"> (opens in a new tab)</span>}</a><button id="copy-contact" class="copy-button mono" data-copy={profile.email||profile.github} hidden>{profile.email?'Copy email':'Copy profile link'} <span aria-hidden="true">▢</span></button></div><p id="copy-status" role="status"></p></div><Polaroid src="images/scrapbook/circuit.jpg" alt="A close-up of electronic circuits, a technology inspiration photo" caption="small pieces, big possibilities" class="contact-photo-right" /></div><div class="contact-signoff"><span class="hand">↳ Good conversations make good beginnings.</span><a href={profile.github} class="profile-handle">@mrayandika15</a><p class="mono">Based in Bandung, Indonesia <span aria-hidden="true">☀</span></p></div></section>
</BaseLayout>
